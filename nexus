function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

function applyBadges(html){
  return html
    .replace(/\[CONF_ALTA\]/g, '<span class="ebadge conf-alta">Confiança alta</span>')
    .replace(/\[CONF_MODERADA\]/g, '<span class="ebadge conf-moderada">Confiança moderada</span>')
    .replace(/\[CONF_BAIXA\]/g, '<span class="ebadge conf-baixa">Confiança baixa</span>')
    .replace(/\[OPINI[AÃ]O\]/g, '<span class="ebadge opiniao">Opinião</span>')
    .replace(/\[RISCO\]/g, '<span class="ebadge risco">Risco</span>');
}

function extractSpecialist(text){
  const match = text.match(/^\s*🜂\s*especialista:\s*(.+)$/mi);
  if (!match) return { specialist: null, cleaned: text };
  const specialist = match[1].trim();
  const cleaned = text.replace(match[0], '').replace(/^\s+/, '');
  return { specialist, cleaned };
}

function extractImagePrompt(text){
  const match = text.match(/🖼\s*imagem:\s*([^\n]+)\s*$/i);
  if (!match) return { imagePrompt: null, cleaned: text };
  const imagePrompt = match[1].trim();
  const cleaned = text.slice(0, match.index).trim();
  return { imagePrompt, cleaned };
}

function buildImageBlock(promptText){
  const wrap = document.createElement('div');
  wrap.className = 'nexus-image';

  const frame = document.createElement('div');
  frame.className = 'frame';

  const skeleton = document.createElement('div');
  skeleton.className = 'image-skeleton';
  skeleton.innerHTML = '<div class="ring"></div><div>gerando imagem…</div>';
  frame.appendChild(skeleton);

  const seed = Math.floor(Math.random() * 1000000);
  const url = 'https://image.pollinations.ai/prompt/' + encodeURIComponent(promptText) + '?width=1024&height=1024&nologo=true&seed=' + seed;

  const img = document.createElement('img');
  img.alt = promptText;
  img.addEventListener('load', () => {
    skeleton.remove();
    img.classList.add('loaded');
  });
  img.addEventListener('error', () => {
    skeleton.innerHTML = '<div class="img-error">Não foi possível gerar a imagem agora. Tente novamente.</div>';
  });
  img.src = url;
  frame.appendChild(img);

  const meta = document.createElement('div');
  meta.className = 'meta';
  const metaText = document.createElement('div');
  metaText.className = 'meta-text';
  metaText.innerHTML = '<div class="meta-label">imagem gerada · pollinations.ai</div><div class="meta-prompt">' + escapeHtml(promptText) + '</div>';
  const dlLink = document.createElement('a');
  dlLink.className = 'dl-link';
  dlLink.textContent = 'baixar';
  dlLink.href = url;
  dlLink.target = '_blank';
  dlLink.rel = 'noopener';
  dlLink.download = '';

  meta.appendChild(metaText);
  meta.appendChild(dlLink);

  wrap.appendChild(frame);
  wrap.appendChild(meta);
  return wrap;
}

function addMessage(role, content, usedWebSearch){
  if (emptyState && emptyState.isConnected) emptyState.remove();

  const msg = document.createElement('div');
  msg.className = 'msg ' + role;

  const avatar = document.createElement('div');
  avatar.className = 'msg-avatar';
  avatar.textContent = role === 'user' ? 'VC' : 'NX';

  const body = document.createElement('div');
  body.className = 'msg-body';

  const roleLabel = document.createElement('div');
  roleLabel.className = 'msg-role';
  roleLabel.textContent = role === 'user' ? 'você' : 'nexus';

  const contentEl = document.createElement('div');
  contentEl.className = 'msg-content';

  let specialistEl = null;
  let searchTag = null;
  if (role === 'user'){
    contentEl.textContent = content;
  } else {
    const { specialist, cleaned: afterSpecialist } = extractSpecialist(content);
    const { imagePrompt, cleaned: finalText } = extractImagePrompt(afterSpecialist);
    if (specialist){
      specialistEl = document.createElement('div');
      specialistEl.className = 'specialist-tag';
      specialistEl.textContent = specialist;
    }
    if (usedWebSearch){
      searchTag = document.createElement('div');
      searchTag.className = 'specialist-tag search-tag';
      searchTag.textContent = 'pesquisa na web utilizada';
    }
    let rawHtml;
    try{
      rawHtml = window.marked ? marked.parse(finalText) : escapeHtml(finalText);
    } catch(_e){
      rawHtml = escapeHtml(finalText); // se o markdown vier malformado, cai pra texto puro em vez de quebrar
    }
    contentEl.innerHTML = applyBadges(rawHtml);
    if (imagePrompt){
      contentEl.appendChild(buildImageBlock(imagePrompt));
    }
  }

  body.appendChild(roleLabel);
  if (specialistEl) body.appendChild(specialistEl);
  if (searchTag) body.appendChild(searchTag);
  body.appendChild(contentEl);
  msg.appendChild(avatar);
  msg.appendChild(body);
  thread.appendChild(msg);
  thread.scrollTop = thread.scrollHeight;
  return contentEl;
}

