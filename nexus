const HISTORY_KEY = 'nexus:history';
const MAX_HISTORY_MESSAGES = 40; // evita estourar o limite de contexto da API em conversas muito longas
const hasStorage = typeof window !== 'undefined' && !!window.storage && typeof window.storage.get === 'function';

function trimHistory(){
  if (history.length > MAX_HISTORY_MESSAGES){
    history = history.slice(history.length - MAX_HISTORY_MESSAGES);
  }
}

async function saveHistory(){
  if (!hasStorage) return;
  try{
    await window.storage.set(HISTORY_KEY, JSON.stringify(history));
  } catch(err){
    console.warn('Não foi possível salvar o histórico:', err);
  }
}

async function loadHistory(){
  if (!hasStorage) return;
  try{
    const result = await window.storage.get(HISTORY_KEY);
    if (!result || !result.value) return;
    const saved = JSON.parse(result.value);
    if (!Array.isArray(saved) || saved.length === 0) return;
    history = saved;
    saved.forEach(m => addMessage(m.role, m.content));
  } catch(err){
    // chave ainda não existe na primeira visita — normal, sem ação necessária
  }
}

async function clearConversation(){
  history = [];
  thread.innerHTML = '';
  thread.appendChild(emptyState);
  if (hasStorage){
    try{ await window.storage.delete(HISTORY_KEY); } catch(err){ /* já vazio, ignora */ }
  }
}
