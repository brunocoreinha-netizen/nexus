function removeTypingIndicator(){
  const el = document.getElementById('typingMsg');
  if (el) el.remove();
}


const RETRYABLE_STATUS = new Set([408, 429, 500, 502, 503, 504]);
const MAX_RETRIES = 2;

function sleep(ms){ return new Promise(r => setTimeout(r, ms)); }

// faz uma única chamada (não-streaming) à API da Claude.
// includeTools controla se a busca na web vai junto — usado para
// o fallback: se a chamada com ferramentas falhar persistentemente,
// tentamos de novo sem elas, pra garantir que sempre volte uma resposta.
async function callOnce(systemPrompt, includeTools){
  const body = {
    model: "claude-sonnet-4-6",
    max_tokens: 1000,
    system: systemPrompt,
    messages: history
  };
  if (includeTools){
    body.tools = [{ type: "web_search_20250305", name: "web_search" }];
  }

  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });

  if (!response.ok){
    let errMsg = 'Erro HTTP ' + response.status;
    try{
      const errBody = await response.json();
      if (errBody && errBody.error && errBody.error.message) errMsg = errBody.error.message;
    } catch(_e){ /* corpo não era JSON, mantém a mensagem genérica */ }
    const err = new Error(errMsg);
    err.status = response.status;
    throw err;
  }

  const data = await response.json();
  if (data.error) throw new Error(data.error.message || 'Erro na chamada da API');

  const content = data.content || [];
  const textBlocks = content.filter(b => b.type === 'text').map(b => b.text);
  const usedWebSearch = content.some(b => b.type === 'server_tool_use' || b.type === 'web_search_tool_result');
  return { text: textBlocks.join('\n\n'), usedWebSearch };
}

// tenta com busca na web + retry em erro momentâneo (5xx/429/rede);
// se tudo isso falhar, faz uma última tentativa sem ferramentas,
// porque uma resposta simples é sempre melhor do que nenhuma resposta.
async function callNexus(systemPrompt){
  let attempt = 0;
  let lastError = null;

  while (attempt <= MAX_RETRIES){
    if (attempt > 0){
      setTypingLabel('reconectando (tentativa ' + (attempt + 1) + ')...');
      await sleep(800 * attempt);
    }
    try{
      return await callOnce(systemPrompt, true);
    } catch(err){
      const retryable = err.status ? RETRYABLE_STATUS.has(err.status) : true; // erro de rede também tenta de novo
      if (retryable && attempt < MAX_RETRIES){
        attempt++;
        lastError = err;
        continue;
      }
      lastError = err;
      break;
    }
  }

  // fallback final: tenta uma vez sem a ferramenta de busca
  try{
    setTypingLabel('respondendo sem busca na web...');
    return await callOnce(systemPrompt, false);
  } catch(err){
    throw lastError || err;
  }
}

async function sendMessage(){
  const text = input.value.trim();
  if (!text || isStreaming) return;

  input.value = '';
  autoGrow();
  addMessage('user', text);
  history.push({ role: 'user', content: text });
  trimHistory();
  saveHistory();

  isStreaming = true;
  sendBtn.disabled = true;
  addTypingIndicator();

  try{
    const systemPrompt = NEXUS_SYSTEM_PROMPT + (MODE_ADDENDUM[currentMode] || '');
    const { text, usedWebSearch } = await callNexus(systemPrompt);

    removeTypingIndicator();

    const finalText = text || 'Não obtive uma resposta. Tente novamente.';
    addMessage('assistant', finalText, usedWebSearch);
    history.push({ role: 'assistant', content: finalText });
    trimHistory();
    saveHistory();

  } catch(err){
    removeTypingIndicator();
    if (emptyState && emptyState.isConnected) emptyState.remove();
    const msg = document.createElement('div');
    msg.className = 'msg assistant';
    const isNetworkErr = err instanceof TypeError;
    const friendly = isNetworkErr
      ? 'Não consegui me conectar (verifique sua internet) — tentei algumas vezes automaticamente e não consegui.'
      : 'Falha ao processar: ' + err.message;
    msg.innerHTML = '<div class="msg-avatar">NX</div><div class="msg-body"><div class="msg-role">nexus</div><div class="error-box">' + escapeHtml(friendly) + '</div></div>';
    thread.appendChild(msg);
    thread.scrollTop = thread.scrollHeight;
  } finally{
    isStreaming = false;
    sendBtn.disabled = false;
    input.focus();
  }
}
